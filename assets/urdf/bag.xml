<mujoco model="bars_cable_basket_final_fixed">
    <compiler autolimits="true"/>
    <option gravity="0 0 -9.81" timestep="0.002"/>

    <worldbody>
        <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="2 2 .05" rgba=".8 .9 .8 1"/>

        <body name="bar_left" pos="-0.175 0 0.8">
            <joint name="move_left_x" type="slide" axis="1 0 0" damping="20"/>
            <geom type="capsule" fromto="0 -0.21 0  0 0.21 0" size="0.012" rgba="0.7 0.3 0.3 1"/>
        </body>

        <body name="bar_right" pos="0.175 0 0.8">
            <joint name="move_right_x" type="slide" axis="1 0 0" damping="20"/>
            <geom type="capsule" fromto="0 -0.21 0  0 0.21 0" size="0.012" rgba="0.3 0.3 0.7 1"/>
        </body>

        <body name="basket" pos="0 0 0.55">
            <freejoint/> 
            <geom name="basket_bottom" type="box" size="0.15 0.175 0.01" rgba="0.5 0.5 0.5 1"/>
        </body>

        <composite type="cable" count="8 1 1" initial="line">
            <joint kind="main" stiffness="0.1" damping="0.05"/>
            <geom type="capsule" size="0.006 0.01" rgba="0.8 0.8 0.8 1" mass="0.001"/>
        </composite>

        <composite type="cable" count="8 1 1" initial="line" offset="0 0.1 0">
            <joint kind="main" stiffness="0.1" damping="0.05"/>
            <geom type="capsule" size="0.006 0.01" rgba="0.8 0.8 0.8 1" mass="0.001"/>
        </composite>

        <composite type="cable" count="8 1 1" initial="line" offset="0 0.2 0">
            <joint kind="main" stiffness="0.1" damping="0.05"/>
            <geom type="capsule" size="0.006 0.01" rgba="0.8 0.8 0.8 1" mass="0.001"/>
        </composite>

        <composite type="cable" count="8 1 1" initial="line" offset="0 0.3 0">
            <joint kind="main" stiffness="0.1" damping="0.05"/>
            <geom type="capsule" size="0.006 0.01" rgba="0.8 0.8 0.8 1" mass="0.001"/>
        </composite>

    </worldbody>

    <equality>
        <weld body1="B0" body2="bar_left"  relpose="0 0.175 0 1 0 0 0"/>
        <weld body1="B7" body2="basket"    relpose="-0.15 0.175 0.01 1 0 0 0"/>

        <weld body1="B8" body2="bar_left"  relpose="0 -0.175 0 1 0 0 0"/>
        <weld body1="B15" body2="basket"   relpose="-0.15 -0.175 0.01 1 0 0 0"/>

        <weld body1="B16" body2="bar_right" relpose="0 0.175 0 1 0 0 0"/>
        <weld body1="B23" body2="basket"    relpose="0.15 0.175 0.01 1 0 0 0"/>

        <weld body1="B24" body2="bar_right" relpose="0 -0.175 0 1 0 0 0"/>
        <weld body1="B31" body2="basket"    relpose="0.15 -0.175 0.01 1 0 0 0"/>
    </equality>

    <actuator>
        <position name="act_left"  joint="move_left_x"  kp="2000" ctrlrange="-0.5 0.5" forcerange="-150 150"/>
        <position name="act_right" joint="move_right_x" kp="2000" ctrlrange="-0.5 0.5" forcerange="-150 150"/>
    </actuator>
</mujoco>
